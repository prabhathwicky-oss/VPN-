# Supabase (Project Settings › API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Public URL of this admin site (used in install commands)
NEXT_PUBLIC_SITE_URL=https://your-admin.vercel.app

# Optional: 1-click server deploy & IP rotation on DigitalOcean
DO_API_TOKEN=
DO_DROPLET_SIZE=s-1vcpu-1gb
# comma separated SSH key IDs/fingerprints added to new droplets
DO_SSH_KEYS=
